# Cloudflare Pages response headers for app.rankactions.com.
# The app shell must always be rechecked, so a deploy is picked up on the next
# load instead of a cached index.html asking for files that no longer exist
# (the white page after the 24 Sep 2026 deploy). Vite names every built asset
# by its content hash, so those can be cached for a year safely.
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/assets/*
  Cache-Control: public, max-age=31536000, immutable
